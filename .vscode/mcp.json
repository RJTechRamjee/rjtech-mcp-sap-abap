{
  // For working on THIS repo: runs the server from source against your local checkout of the
  // skills repo (sibling folder). Your SAP settings still come from %USERPROFILE%\.rjtech-mcp\config.env.
  // Team members use the npx config from TEAM-SETUP.md instead.
  "servers": {
    "sap-abap-skills-dev": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "${workspaceFolder}/server/src/index.ts"],
      "env": {
        "LOCAL_CONTENT_DIR": "${workspaceFolder}/../rjtech-sap-abap-skills"
      }
    }
  }
}
