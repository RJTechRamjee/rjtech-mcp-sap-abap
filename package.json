{
  "name": "rjtech-mcp-sap-abap",
  "version": "0.2.0",
  "description": "Local MCP server (stdio) that serves a team's SAP ABAP Agent Skills, synced live from a GitHub repo, plus optional ADT tools",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RJTechRamjee/rjtech-mcp-sap-abap.git"
  },
  "bin": {
    "rjtech-mcp-sap-abap": "dist/rjtech-mcp-sap-abap.mjs"
  },
  "files": [
    "dist/rjtech-mcp-sap-abap.mjs"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "dev": "tsx server/src/index.ts",
    "setup": "tsx server/src/index.ts setup",
    "validate": "tsx server/src/index.ts validate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx server/src/index.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  }
}
